# reviewly environment configuration
# copy to .env and fill in values

# core
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=http://localhost:8001
FRONTEND_BASE_URL=http://localhost:5173
# host-side port for backend (avoids clashes; container always listens on 8000)
BACKEND_HOST_PORT=8001
LOG_LEVEL=INFO

# security
# generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=change-me-to-a-valid-fernet-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# database (use simple chars only - no @ ! / in dev passwords)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=reviewly
POSTGRES_USER=reviewly
POSTGRES_PASSWORD=reviewly_dev_password
DATABASE_URL=postgresql+asyncpg://reviewly:reviewly_dev_password@postgres:5432/reviewly

# redis / queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# claude / anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.2

# github app
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-key.pem
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_NAME=basira-dev

# cors
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# review engine knobs
REVIEW_MAX_FILES=50
REVIEW_MAX_DIFF_BYTES=200000
REVIEW_SEVERITY_THRESHOLD=medium

# rate limits
RATE_LIMIT_GENERAL=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_WEBHOOK=120/minute
RATE_LIMIT_USER_HOURLY=1000/hour

# frontend (consumed by vite)
VITE_API_BASE_URL=http://localhost:8001
